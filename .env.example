# ============================================
# 环境变量配置模板
# 复制为 .env 后填入真实值：cp .env.example .env
# ============================================

# ============================================
# 后端 [必需]
# ============================================
SECRET_KEY=your-secret-key-here-change-this-in-production
OPENAI_API_KEY=your-openai-api-key-here
CLERK_SECRET_KEY=your-clerk-secret-key-here
JWKS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
YOUR_JWKS_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"

# ============================================
# 前端 [必需]
# ============================================
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here
VITE_API_URL=http://localhost:8000
API_V1_STR=/api/v1

# ============================================
# 端口（可选，有默认值）
# ============================================
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5433

# ============================================
# 数据库（可选，有默认值）
# 本地直连后端用 localhost；docker-compose 内会覆盖为 db
# ============================================
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=questions_db

# ============================================
# 其他（可选）
# ============================================
PROJECT_NAME=Questions API
